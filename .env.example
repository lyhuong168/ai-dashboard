# Copy this file to .env and fill it in. .env is git-ignored. NEVER commit real keys.
# Only Reid's RAG/agent code needs the OpenAI settings; Manny and Lyhuong can leave them blank.
OPENAI_API_KEY=
OPENAI_MODEL_QA=gpt-4o
OPENAI_MODEL_EXTRACT=gpt-4o-mini
OPENAI_MODEL_EMBED=text-embedding-3-small
# Hard cap on estimated spend per refresh run (USD). The pipeline stops when it hits this.
MAX_USD_PER_RUN=2.00
# REQUIRED for downloading SEC filings: the SEC blocks requests without a real contact.
# Format:  SEC_USER_AGENT=Your Name your.email@school.edu
SEC_USER_AGENT=
